<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    
    <!-- 背景渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:type="linear"
                android:angle="135"
                android:startColor="#1A1A2E"
                android:centerColor="#16213E"
                android:endColor="#0F3460"
                android:centerX="0.3"
                android:centerY="0.3"/>
        </shape>
    </item>
    
    <!-- 装饰性圆形 -->
    <item
        android:left="-20dp"
        android:top="-20dp"
        android:right="60dp"
        android:bottom="60dp">
        <shape android:shape="oval">
            <solid android:color="#20FFFFFF"/>
        </shape>
    </item>
    
    <item
        android:left="70dp"
        android:top="70dp"
        android:right="-10dp"
        android:bottom="-10dp">
        <shape android:shape="oval">
            <solid android:color="#154ECDC4"/>
        </shape>
    </item>
    
</layer-list>
