<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 外圈 -->
    <item>
        <shape android:shape="oval">
            <stroke
                android:width="2dp"
                android:color="@color/accent_glow" />
            <size
                android:width="80dp"
                android:height="80dp" />
        </shape>
    </item>
    <!-- 四角标记 -->
