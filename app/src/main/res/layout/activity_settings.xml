<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- 标题 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="水印设置"
            android:textSize="28sp"
            android:textStyle="bold"
            android:gravity="center"
            android:layout_marginBottom="24dp"
            android:textColor="@color/on_background" />

        <!-- 水印样式卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface"
            app:cardUseCompatPadding="true">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 文本大小设置 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="水印文本大小"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/on_surface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/textSizeSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="80"
                        android:progressTint="@color/primary"
                        android:thumbTint="@color/primary" />

                    <TextView
                        android:id="@+id/textSizeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="48sp"
                        android:textSize="16sp"
                        android:textColor="@color/on_surface" />

                </LinearLayout>

                <!-- 水印颜色设置 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="水印颜色"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/on_surface" />

                <View
                    android:id="@+id/colorPreview"
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="#FFFFFF"
                    android:layout_marginBottom="16dp"
                    android:elevation="2dp"
                    android:backgroundTint="@color/primary" />

                <!-- 背景透明度设置 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="背景透明度"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/on_surface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/backgroundAlphaSeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="255"
                        android:progressTint="@color/primary"
                        android:thumbTint="@color/primary" />

                    <TextView
                        android:id="@+id/backgroundAlphaValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="50%"
                        android:textSize="16sp"
                        android:textColor="@color/on_surface" />

                </LinearLayout>

                <!-- 水印位置设置 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="水印位置"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/on_surface" />

                <Spinner
                    android:id="@+id/watermarkPositionSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:background="@color/surface_variant"
                    android:elevation="2dp"
                    android:backgroundTint="@color/surface_variant" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 内容设置卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface"
            app:cardUseCompatPadding="true">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 显示位置信息开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="显示位置信息"
                        android:textSize="18sp"
                        android:textColor="@color/on_surface" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/showLocationSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/primary"
                        android:trackTint="@color/surface_variant" />

                </LinearLayout>

                <!-- 显示日期时间开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="显示日期时间"
                        android:textSize="18sp"
                        android:textColor="@color/on_surface" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/showDateTimeSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/primary"
                        android:trackTint="@color/surface_variant" />

                </LinearLayout>

                <!-- 获取海拔信息开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="获取海拔信息"
                        android:textSize="18sp"
                        android:textColor="@color/on_surface" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/fetchElevationSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/primary"
                        android:trackTint="@color/surface_variant" />

                </LinearLayout>

                <!-- 显示地址信息开关 -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="显示地址信息"
                        android:textSize="18sp"
                        android:textColor="@color/on_surface" />

                    <androidx.appcompat.widget.SwitchCompat
                        android:id="@+id/showAddressSwitch"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:thumbTint="@color/primary"
                        android:trackTint="@color/surface_variant" />

                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="提示：关闭海拔信息可提高拍照速度"
                    android:textSize="14sp"
                    android:textColor="@color/on_surface_variant"
                    android:layout_marginBottom="8dp" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 高级设置卡片 -->
        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="4dp"
            app:cardBackgroundColor="@color/surface"
            app:cardUseCompatPadding="true">
            
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- 自定义水印文本 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="自定义水印文本"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/on_surface" />

                <EditText
                    android:id="@+id/customWatermarkEditText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="输入自定义水印文本"
                    android:layout_marginBottom="16dp"
                    android:background="@color/surface_variant"
                    android:backgroundTint="@color/surface_variant"
                    android:elevation="2dp"
                    android:padding="12dp"
                    android:textColor="@color/on_surface"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:imeOptions="actionDone" />

                <!-- 图片质量设置 -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="图片质量"
                    android:textSize="18sp"
                    android:layout_marginBottom="8dp"
                    android:textColor="@color/on_surface" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="16dp"
                    android:gravity="center_vertical">

                    <SeekBar
                        android:id="@+id/imageQualitySeekBar"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:max="100"
                        android:progress="90"
                        android:progressTint="@color/primary"
                        android:thumbTint="@color/primary" />

                    <TextView
                        android:id="@+id/imageQualityValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="16dp"
                        android:text="90%"
                        android:textSize="16sp"
                        android:textColor="@color/on_surface" />

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- 重置按钮 -->
        <Button
            android:id="@+id/resetButton"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="重置为默认设置"
            android:textSize="18sp"
            android:textColor="@color/on_primary"
            android:background="@color/primary"
            android:elevation="4dp"
            android:stateListAnimator="@null"
            android:backgroundTint="@color/primary"
            android:layout_marginBottom="16dp" />

    </LinearLayout>

</ScrollView>
