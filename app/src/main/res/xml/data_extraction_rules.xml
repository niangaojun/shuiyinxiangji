<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- 配置哪些数据应该包含在云备份中 -->
        <exclude domain="sharedpref" path="*" />
        <exclude domain="database" path="*" />
        <exclude domain="file" path="*" />
    </cloud-backup>
    <device-transfer>
        <!-- 配置哪些数据应该包含在设备间传输中 -->
        <exclude domain="sharedpref" path="*" />
        <exclude domain="database" path="*" />
        <exclude domain="file" path="*" />
    </device-transfer>
</data-extraction-rules>