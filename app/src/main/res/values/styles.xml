<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- 基础应用主题 - 现代深色主题 -->
    <style name="Theme.WatermarkCamera" parent="Theme.Material3.Dark.NoActionBar">
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryVariant">@color/primary_container</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorSecondaryVariant">@color/secondary_container</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorSurfaceVariant">@color/surface_variant</item>
        <item name="colorOnSurfaceVariant">@color/on_surface_variant</item>
        <item name="colorOutline">@color/outline</item>
        
        <!-- 全局字体设置 - 阿里巴巴普惠体 -->
        <!-- 使用说明：
             1. 下载阿里巴巴普惠体字体文件（.ttf格式）
             2. 将字体文件重命名为 alibaba_puhuiti_regular.ttf
             3. 放到 app/src/main/res/font/ 文件夹中
             4. 取消下面4行的注释即可启用阿里巴巴普惠体
        -->
        <!-- <item name="android:fontFamily">@font/alibaba_puhuiti_regular</item> -->
        <!-- <item name="fontFamily">@font/alibaba_puhuiti_regular</item> -->
        <!-- <item name="android:textViewStyle">@style/TextViewStyle</item> -->
        <!-- <item name="android:buttonStyle">@style/ButtonStyle</item> -->
        
        <!-- 状态栏设置 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">false</item>
        
        <!-- 窗口背景 -->
        <item name="android:windowBackground">@color/background</item>
        
        <!-- 动画设置 -->
        <item name="android:windowActivityTransitions">true</item>
        <item name="android:windowContentTransitions">true</item>
    </style>
    
    <!-- TextView 样式 - 使用阿里巴巴普惠体 -->
    <!-- 取消下面的注释以启用阿里巴巴普惠体 -->
    <!--
    <style name="TextViewStyle" parent="android:Widget.TextView">
        <item name="android:fontFamily">@font/alibaba_puhuiti_regular</item>
    </style>
    -->
    
    <!-- Button 样式 - 使用阿里巴巴普惠体 -->
    <!-- 取消下面的注释以启用阿里巴巴普惠体 -->
    <!--
    <style name="ButtonStyle" parent="android:Widget.Material.Button">
        <item name="android:fontFamily">@font/alibaba_puhuiti_regular</item>
    </style>
    -->

    <!-- 全屏主题 -->
    <style name="Theme.WatermarkCamera.Fullscreen" parent="Theme.WatermarkCamera">
        <item name="android:windowFullscreen">true</item>
        <item name="windowActionBar">false</item>
        <item name="windowNoTitle">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowTranslucentStatus">true</item>
        <item name="android:windowTranslucentNavigation">true</item>
    </style>
    
    <!-- 按钮样式 -->
    <style name="CameraIconButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/bg_icon_button</item>
        <item name="android:padding">12dp</item>
        <item name="android:scaleType">centerInside</item>
        <item name="tint">@color/white</item>
    </style>
    
    <!-- 拍照按钮样式 -->
    <style name="CaptureButton" parent="Widget.AppCompat.ImageButton">
        <item name="android:background">@drawable/capture_button_inner</item>
        <item name="android:elevation">8dp</item>
    </style>
</resources>
